# Linux Bash; run/source from the repository root. Replace the dataset path and
# generate train.jsonl first; see README_zh-CN.md. This is continued
# fine-tuning from the released step-500, NOT the historical initial run, TAWD,
# or a reproduction of manuscript results. No server or GPU is reserved here.
export TRAINING_MANIFEST_PROFILE=public
export DATASET_BASE_PATH=/path/to/robotwin_training
export TRAINING_MANIFEST=manifests/my_robotwin/train.jsonl
export TRAINING_MANIFEST_SHA256=YOUR_GENERATED_TRAIN_MANIFEST_64_HEX_SHA256
export RESUME_CHECKPOINT=checkpoints/KineWorld/step-500.safetensors
export RESUME_CHECKPOINT_SHA256=86294739c54073c836a0dcb3f9114c6cf2bf83d1a8698423b71698e5f88460a3
export MODEL_CACHE_DIR=models
export KINEWORLD_RAFT_WEIGHTS_PATH=models/raft/raft_large_C_T_SKHT_V2-ff5fadd5.pth
export NUM_GPUS=1
export OUTPUT_PATH=outputs/kineworld-public-finetune

# Shape/conditioning contract from training_config_public.json in the release.
export VARIANTS=aloha-agilex_clean_50
export CAMERAS=head_camera
export CAMERA_PREFIX=''
export TRACK1_PROMPT_TEMPLATE=true
export FLOW_MODE=robot_only
export FLOW_METHOD=raft
export VIDEO_OBJECTIVE=track1_conditional_rgb
export FLOW_LOSS_WEIGHT=0
export ACTION_LOSS_WEIGHT=1
export NUM_FRAMES=33
export NUM_VIDEO_FRAMES=9
export VISUAL_STRIDE=4
export SIZE_W=320
export SIZE_H=240
export COND_LAYER_STRIDE=2
export COND_DETACH=true
export NUM_ACTION_LAYERS=30
export ACTION_PRED_TARGET=velocity
export ACTION_POS_MODE=rope
export PROPRIO_MODE=text
export LEARNING_RATE=1e-4
# Configurable 500-update schedule; a 3-update smoke run tests plumbing only.
export LR_MAX_STEPS=500
export LR_WARMUP_STEPS=25
export BATCH_SIZE=1
export GRADIENT_ACCUMULATION_STEPS=1
export USE_GRADIENT_CHECKPOINTING=true
export DATASET_NUM_WORKERS=0

# Device-adaptive safety gate; 0 means no artificial occupancy floor and, for
# MAX_VRAM_GIB, a cap of 95% of each device total. Hardware fit is NOT guaranteed.
export MIN_ALLOCATED_GIB=0
export MIN_VRAM_GIB=0
export MAX_VRAM_GIB=0
export VRAM_PROBE_STEP=3
export SAVE_STEPS=100
export FULL_STATE_KEEP=2
export SWANLAB_MODE=local

# First perform CPU file/hash/header checks (no torch/GPU/downloads/outputs):
#   bash training/train.sh --dry-run
# Then choose a bounded *real* smoke run (>= VRAM_PROBE_STEP); it writes a final
# step-3.safetensors after successful updates. Requires actual compatible GPUs:
#   MAX_OPTIMIZER_STEPS=3 SAVE_STEPS=3 bash training/train.sh
# For a longer run, use a NEW OUTPUT_PATH; do not mix weights-only warm-start
# with RESUME_STATE_DIR (the latter restores full optimizer/scheduler/RNG state).
